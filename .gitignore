# ─────────────────────────────────────────────
# 실행 결과물
# 어닝콜 분석을 실행할 때마다 자동으로 만들어집니다.
# GitHub에 올릴 필요 없고, 올리면 매번 충돌납니다.
# ─────────────────────────────────────────────
artifacts/


# ─────────────────────────────────────────────
# 어닝콜 원문 텍스트 파일
# 처리할 콘텐츠 데이터입니다. 용량도 크고 저작권 이슈가
# 있을 수 있어서 GitHub에 올리지 않습니다.
# ─────────────────────────────────────────────
input/*.txt


# ─────────────────────────────────────────────
# Claude Code 로컬 권한 설정
# 이 컴퓨터의 경로와 권한이 담겨 있습니다.
# 다른 컴퓨터에서 열면 오작동하므로 제외합니다.
# ─────────────────────────────────────────────
.claude/settings.local.json


# ─────────────────────────────────────────────
# 운영체제가 자동으로 만드는 숨김 파일
# ─────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

